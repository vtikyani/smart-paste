<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows tray app. WPF for the UI; the Windows 10 2004 SDK projection for the built-in OCR engine
       (Windows.Media.Ocr). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>SmartPaste</AssemblyName>
    <RootNamespace>SmartPaste.App</RootNamespace>
    <StartupObject>SmartPaste.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartPaste.Core\SmartPaste.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Interop.UIAutomationClient" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="WPF-UI" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmartPaste.App.Tests" />
    <!-- WPF projects leave System.IO out of the implicit usings (it clashes with System.Windows.Shapes.Path). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- Program.Main starts the app (Velopack must run first), so App.xaml must not generate a Main of its own. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

</Project>
