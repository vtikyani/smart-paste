<!--
  A practice form field. When Smart Paste fills it, a highlighter sweeps over the value and fades to a soft wash
  that stays while the value is the smart-pasted one. DataContext: PracticeFieldViewModel.
-->
<UserControl
  x:Class="SmartPaste.App.UI.Onboarding.PracticeField"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:onboarding="clr-namespace:SmartPaste.App.UI.Onboarding"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=onboarding:PracticeFieldViewModel}"
  Focusable="False"
  IsTabStop="False">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SmartPaste;component/UI/Settings/SettingsStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- A Fluent text box with room behind the text for the highlighter. -->
      <Style x:Key="PracticeTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Brand.FontText}" />
        <Setter Property="FontSize" Value="{DynamicResource Brand.SizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorSelectedTextBackgroundBrush}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border
                x:Name="Frame"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}">
                <Grid>
                  <Border
                    x:Name="Wash"
                    Margin="3"
                    Background="{DynamicResource Brand.HighlightWashBrush}"
                    CornerRadius="3"
                    Visibility="Collapsed" />
                  <Border
                    x:Name="Marker"
                    Height="24"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Brand.HighlightFillBrush}"
                    CornerRadius="4"
                    Opacity="0"
                    RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                      <ScaleTransform ScaleX="1" />
                    </Border.RenderTransform>
                  </Border>
                  <ScrollViewer
                    x:Name="PART_ContentHost"
                    Margin="9,0,9,0"
                    VerticalAlignment="Center"
                    Focusable="False"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Hidden" />
                  <Border
                    x:Name="FocusLine"
                    Height="2"
                    Margin="0,0,0,-1"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    CornerRadius="0,0,4,4"
                    Visibility="Collapsed" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFilled}" Value="True">
                  <Setter TargetName="Wash" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
                  <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="112" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      VerticalAlignment="Center"
      FontSize="{DynamicResource Brand.SizeBody}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Text="{Binding Label}"
      TextWrapping="Wrap" />
    <TextBox
      x:Name="Input"
      Grid.Column="1"
      AutomationProperties.Name="{Binding Label}"
      Style="{StaticResource PracticeTextBox}"
      Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />

    <!-- Who decided, while deciding, or what went wrong. -->
    <Grid
      Grid.Row="1"
      Grid.Column="1"
      MinHeight="18"
      Margin="1,5,0,0"
      AutomationProperties.LiveSetting="Polite">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ui:ProgressRing
        Width="12"
        Height="12"
        Margin="0,2,6,0"
        VerticalAlignment="Top"
        IsIndeterminate="True"
        Visibility="{Binding IsDeciding, Converter={StaticResource Settings.BoolToVisibility}}" />
      <ui:SymbolIcon Margin="0,1,5,0" VerticalAlignment="Top" FontSize="13" Filled="True">
        <ui:SymbolIcon.Style>
          <Style TargetType="ui:SymbolIcon">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding State}" Value="Filled">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Symbol" Value="Tag20" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding State}" Value="Filled" />
                  <Condition Binding="{Binding DecidedByJev}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Symbol" Value="Sparkle20" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              </MultiDataTrigger>
              <DataTrigger Binding="{Binding State}" Value="Problem">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Symbol" Value="Warning20" />
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ui:SymbolIcon.Style>
      </ui:SymbolIcon>
      <TextBlock
        Grid.Column="1"
        FontSize="{DynamicResource Brand.SizeCaption}"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding Caption}"
        TextWrapping="Wrap" />
    </Grid>
  </Grid>
</UserControl>
