<!--
  The right end of the Windows taskbar with Smart Paste's icon marked, so people know where to find it. The clock
  shows the real time.
-->
<UserControl
  x:Class="SmartPaste.App.UI.Onboarding.TrayIllustration"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  AutomationProperties.Name="Illustration: the Smart Paste icon in the notification area of the taskbar."
  Focusable="False"
  IsTabStop="False">

  <StackPanel HorizontalAlignment="Center">
    <!-- Callout pointing at the icon. -->
    <StackPanel Margin="58,0,0,0" HorizontalAlignment="Left">
      <Border
        Padding="10,5,10,6"
        Background="{DynamicResource Brand.HighlightFillBrush}"
        CornerRadius="{DynamicResource Brand.RadiusSmall}">
        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brand.HighlightTextBrush}" Text="Smart Paste" />
      </Border>
      <Path
        Width="12"
        Height="7"
        Margin="0,-1,0,6"
        HorizontalAlignment="Center"
        Data="M0,0 L12,0 L6,7 Z"
        Fill="{DynamicResource Brand.HighlightFillBrush}" />
    </StackPanel>

    <!-- The taskbar corner. -->
    <Border
      Padding="10,6,14,6"
      Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="{DynamicResource Brand.RadiusControl}">
      <StackPanel Orientation="Horizontal">
        <Border Width="32" Height="36" CornerRadius="4">
          <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Symbol="ChevronUp20" />
        </Border>
        <Border
          Width="36"
          Height="36"
          Margin="4,0,8,0"
          Background="{DynamicResource SubtleFillColorSecondaryBrush}"
          BorderBrush="{DynamicResource Brand.HighlightFillBrush}"
          BorderThickness="1.5"
          CornerRadius="6">
          <Image
            Width="18"
            Height="18"
            RenderOptions.BitmapScalingMode="HighQuality"
            Source="{DynamicResource Brand.LogoImage}" />
        </Border>
        <ui:SymbolIcon Margin="6,0,8,0" VerticalAlignment="Center" FontSize="16" Symbol="Wifi120" />
        <ui:SymbolIcon Margin="0,0,14,0" VerticalAlignment="Center" FontSize="16" Symbol="Speaker220" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock
            x:Name="Time"
            HorizontalAlignment="Right"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock
            x:Name="Date"
            HorizontalAlignment="Right"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
