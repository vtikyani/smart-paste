<UserControl
  x:Class="SmartPaste.App.UI.Onboarding.Steps.ConnectStep"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:settings="clr-namespace:SmartPaste.App.UI.Settings"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <UserControl.Resources>
    <ResourceDictionary Source="/SmartPaste;component/UI/Onboarding/OnboardingStyles.xaml" />
  </UserControl.Resources>

  <StackPanel VerticalAlignment="Center">
    <TextBlock Style="{StaticResource Onboarding.Title}" Text="Connect Jev" />
    <TextBlock
      MaxWidth="560"
      HorizontalAlignment="Left"
      Style="{StaticResource Onboarding.Lead}"
      Text="One OpenRouter key lets Smart Paste read what you copy and lets Jev decide every paste. It's kept by Windows Credential Manager, never in a file." />

    <settings:ApiKeyEditor Margin="0,24,0,0" DataContext="{Binding OpenRouterKey}" />

    <!-- Only while no key is saved: skipping is fine, and here's what it means. -->
    <Border
      Margin="0,12,0,0"
      Padding="14,12,16,12"
      Background="{DynamicResource SubtleFillColorSecondaryBrush}"
      CornerRadius="{DynamicResource Brand.RadiusControl}"
      Visibility="{Binding OpenRouterKey.IsSaved, Converter={StaticResource Settings.FalseToVisible}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon Margin="0,1,10,0" VerticalAlignment="Top" FontSize="16" Symbol="Info24" />
        <TextBlock Grid.Column="1" Style="{StaticResource Onboarding.ItemText}" Margin="0">
          <Run FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="No key yet? Skip for now." />
          <Run Text="Smart Paste uses its built-in label list until you add a key in Settings." />
        </TextBlock>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
