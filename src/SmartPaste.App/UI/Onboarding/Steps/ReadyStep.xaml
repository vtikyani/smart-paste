<UserControl
  x:Class="SmartPaste.App.UI.Onboarding.Steps.ReadyStep"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:onboarding="clr-namespace:SmartPaste.App.UI.Onboarding"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <UserControl.Resources>
    <ResourceDictionary Source="/SmartPaste;component/UI/Onboarding/OnboardingStyles.xaml" />
  </UserControl.Resources>

  <StackPanel VerticalAlignment="Center">
    <TextBlock Style="{StaticResource Onboarding.Title}" Text="You're all set" />
    <TextBlock
      MaxWidth="560"
      HorizontalAlignment="Left"
      Style="{StaticResource Onboarding.Lead}"
      Text="Smart Paste runs quietly in the background. Copy a block of text whenever you need it, then press Ctrl+V in a form." />

    <Grid Margin="0,30,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <onboarding:TrayIllustration VerticalAlignment="Bottom" />
      <StackPanel Grid.Column="1" Margin="28,0,0,4" VerticalAlignment="Bottom">
        <TextBlock Style="{StaticResource Onboarding.ItemTitle}" Text="Find Smart Paste in your tray" />
        <TextBlock Style="{StaticResource Onboarding.ItemText}" Text="It sits at the right end of the taskbar. Don't see it? Select Show hidden icons (^)." />
      </StackPanel>
    </Grid>

    <ui:CardControl Margin="0,30,0,0" Icon="{ui:SymbolIcon Rocket24}" Style="{StaticResource Settings.Card}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource Settings.CardTitle}" Text="Start Smart Paste when I sign in" />
          <TextBlock Style="{StaticResource Settings.CardDescription}" Text="So it's ready whenever you need it. You can change this in Settings." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch
        AutomationProperties.Name="Start Smart Paste when I sign in"
        IsChecked="{Binding StartAtLogin}"
        OffContent="Off"
        OnContent="On" />
    </ui:CardControl>
  </StackPanel>
</UserControl>
