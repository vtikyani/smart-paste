<UserControl
  x:Class="SmartPaste.App.UI.Onboarding.Steps.HowItWorksStep"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SmartPaste;component/UI/Onboarding/OnboardingStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Dotted line from one step to the next. -->
      <Style x:Key="Connector" TargetType="Line">
        <Setter Property="X1" Value="0" />
        <Setter Property="X2" Value="1" />
        <Setter Property="Stretch" Value="Fill" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeDashArray" Value="1 3" />
        <Setter Property="StrokeDashCap" Value="Round" />
        <Setter Property="Stroke" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="52,0,14,0" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel VerticalAlignment="Center">
    <TextBlock Style="{StaticResource Onboarding.Title}" Text="How it works" />

    <Grid Margin="0,26,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Style="{StaticResource Settings.IconTile}" HorizontalAlignment="Left">
        <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Symbol="Copy24" />
      </Border>
      <Line Style="{StaticResource Connector}" />
      <StackPanel Grid.Row="1" Margin="0,14,24,0">
        <TextBlock Style="{StaticResource Onboarding.ItemTitle}" Text="Copy a block." />
        <TextBlock Style="{StaticResource Onboarding.ItemText}" Text="A resume, an address, a contact card: anything with your details." />
      </StackPanel>

      <Border Grid.Column="1" Style="{StaticResource Settings.IconTile}" HorizontalAlignment="Left">
        <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Symbol="CursorClick24" />
      </Border>
      <Line Grid.Column="1" Style="{StaticResource Connector}" />
      <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,24,0">
        <TextBlock Style="{StaticResource Onboarding.ItemTitle}" Text="Click a field." />
        <TextBlock Style="{StaticResource Onboarding.ItemText}" Text="In any form, in any app or website." />
      </StackPanel>

      <Border Grid.Column="2" Style="{StaticResource Settings.HighlighterTile}" HorizontalAlignment="Left">
        <ui:SymbolIcon
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          FontSize="20"
          Foreground="{DynamicResource Brand.HighlightTextBrush}"
          Symbol="ClipboardPaste24" />
      </Border>
      <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
        <TextBlock Style="{StaticResource Onboarding.ItemTitle}" Text="Press Ctrl+V." />
        <TextBlock Style="{StaticResource Onboarding.ItemText}" Text="Smart Paste pastes just the part that field wants." />
      </StackPanel>
    </Grid>

    <!-- Jev: the decision behind every paste. -->
    <Border
      Margin="0,30,0,0"
      Padding="20,18,22,18"
      CornerRadius="{DynamicResource Brand.RadiusCard}"
      Style="{StaticResource Settings.Panel}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Settings.IconTile}">
          <ui:SymbolIcon
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="20"
            Filled="True"
            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
            Symbol="Sparkle24" />
        </Border>
        <StackPanel Grid.Column="1" Margin="16,0,0,0">
          <TextBlock Style="{StaticResource Onboarding.ItemTitle}" Text="Jev decides every paste" />
          <TextBlock Style="{StaticResource Onboarding.ItemText}" Text="Jev, TypeSafe's decision model, reads the field, its label and what's around it, and picks which of your copied values goes there. If it isn't sure, you choose." />
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
      <ItemsControl Style="{StaticResource KeyCap.Row}">
        <ItemsControl.ItemsSource>
          <x:Array Type="{x:Type sys:String}">
            <sys:String>Ctrl</sys:String>
            <sys:String>Shift</sys:String>
            <sys:String>V</sys:String>
          </x:Array>
        </ItemsControl.ItemsSource>
      </ItemsControl>
      <TextBlock
        VerticalAlignment="Center"
        Style="{StaticResource Onboarding.ItemText}"
        Margin="6,0,0,0"
        Text="always pastes your original, untouched." />
    </StackPanel>
  </StackPanel>
</UserControl>
