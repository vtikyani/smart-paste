<!--
  The idea of Smart Paste in one loop: a copied block, Ctrl+V, and the one value the field wants appears in it,
  highlighted. Lines stand in for text, so the picture never shows anyone's details. Loops calmly (6 s); with
  Windows animation effects off it shows the finished state and doesn't move.
-->
<UserControl
  x:Class="SmartPaste.App.UI.Onboarding.PasteFlowIllustration"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Width="300"
  AutomationProperties.Name="Illustration: copy a block of text, press Ctrl+V in a field, and only the right value is pasted."
  Focusable="False"
  IsTabStop="False">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SmartPaste;component/UI/Controls/HotkeyBox.KeyCaps.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="Bar" TargetType="Border">
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ControlStrongFillColorDefaultBrush}" />
        <Setter Property="Opacity" Value="0.38" />
      </Style>

      <Style x:Key="InkBar" TargetType="Border" BasedOn="{StaticResource Bar}">
        <Setter Property="Background" Value="{DynamicResource Brand.HighlightTextBrush}" />
        <Setter Property="Opacity" Value="0" />
      </Style>

      <Style x:Key="Marker" TargetType="Border">
        <Setter Property="Height" Value="18" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brand.HighlightFillBrush}" />
        <Setter Property="RenderTransformOrigin" Value="0,0.5" />
      </Style>

      <!-- One 6-second cycle: mark the line, press the keys, fill the field, hold, fade, rest. -->
      <Storyboard x:Key="Loop" RepeatBehavior="Forever">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LineMarkScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:6">
          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:0.45" Value="0" />
          <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="1">
            <EasingDoubleKeyFrame.EasingFunction>
              <QuinticEase EasingMode="EaseOut" />
            </EasingDoubleKeyFrame.EasingFunction>
          </EasingDoubleKeyFrame>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LineMark" Storyboard.TargetProperty="Opacity" Duration="0:0:6">
          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:4.6" Value="1" />
          <EasingDoubleKeyFrame KeyTime="0:0:5" Value="0" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LineInk" Storyboard.TargetProperty="Opacity" Duration="0:0:6">
          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:0.45" Value="0" />
          <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0.9" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:4.6" Value="0.9" />
          <EasingDoubleKeyFrame KeyTime="0:0:5" Value="0" />
        </DoubleAnimationUsingKeyFrames>

        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CtrlScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:6">
          <DiscreteDoubleKeyFrame KeyTime="0:0:1.25" Value="1" />
          <EasingDoubleKeyFrame KeyTime="0:0:1.37" Value="0.9" />
          <EasingDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CtrlScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:6">
          <DiscreteDoubleKeyFrame KeyTime="0:0:1.25" Value="1" />
          <EasingDoubleKeyFrame KeyTime="0:0:1.37" Value="0.9" />
          <EasingDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:6">
          <DiscreteDoubleKeyFrame KeyTime="0:0:1.3" Value="1" />
          <EasingDoubleKeyFrame KeyTime="0:0:1.42" Value="0.9" />
          <EasingDoubleKeyFrame KeyTime="0:0:1.65" Value="1" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:6">
          <DiscreteDoubleKeyFrame KeyTime="0:0:1.3" Value="1" />
          <EasingDoubleKeyFrame KeyTime="0:0:1.42" Value="0.9" />
          <EasingDoubleKeyFrame KeyTime="0:0:1.65" Value="1" />
        </DoubleAnimationUsingKeyFrames>

        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FieldMarkScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:6">
          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
          <EasingDoubleKeyFrame KeyTime="0:0:2" Value="1">
            <EasingDoubleKeyFrame.EasingFunction>
              <QuinticEase EasingMode="EaseOut" />
            </EasingDoubleKeyFrame.EasingFunction>
          </EasingDoubleKeyFrame>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FieldValue" Storyboard.TargetProperty="Opacity" Duration="0:0:6">
          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
          <EasingDoubleKeyFrame KeyTime="0:0:1.95" Value="1" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:4.6" Value="1" />
          <EasingDoubleKeyFrame KeyTime="0:0:5" Value="0" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FieldValueShift" Storyboard.TargetProperty="X" Duration="0:0:6">
          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-8" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="-8" />
          <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0">
            <EasingDoubleKeyFrame.EasingFunction>
              <QuinticEase EasingMode="EaseOut" />
            </EasingDoubleKeyFrame.EasingFunction>
          </EasingDoubleKeyFrame>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CaretShift" Storyboard.TargetProperty="X" Duration="0:0:6">
          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:1.7" Value="188" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:5" Value="0" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Caret" Storyboard.TargetProperty="Opacity" Duration="0:0:6">
          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="1" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:1.5" Value="0" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="1" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:2.5" Value="0" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="1" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:3.5" Value="0" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:4" Value="1" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:4.5" Value="0" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:5" Value="1" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:5.5" Value="0" />
        </DoubleAnimationUsingKeyFrames>
      </Storyboard>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel>
    <!-- The copied block. -->
    <Border
      Padding="20,16,20,20"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="{DynamicResource Brand.RadiusCard}">
      <StackPanel>
        <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
          <Path
            Width="12"
            Height="14"
            Margin="0,0,7,0"
            VerticalAlignment="Center"
            Data="M3,0 H10 A2,2 0 0 1 12,2 V10 M1,3 H7 A1,1 0 0 1 8,4 V13 A1,1 0 0 1 7,14 H1 A1,1 0 0 1 0,13 V4 A1,1 0 0 1 1,3 Z"
            Stretch="Uniform"
            Stroke="{DynamicResource TextFillColorSecondaryBrush}"
            StrokeThickness="1.2" />
          <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Copied" />
        </StackPanel>
        <Border Width="118" Margin="0,0,0,12" Style="{StaticResource Bar}" />
        <Grid Height="18" Margin="-6,0,0,12">
          <Border x:Name="LineMark" Width="190" Style="{StaticResource Marker}">
            <Border.RenderTransform>
              <ScaleTransform x:Name="LineMarkScale" ScaleX="0" />
            </Border.RenderTransform>
          </Border>
          <Border Width="176" Margin="6,0,0,0" Style="{StaticResource Bar}" />
          <Border x:Name="LineInk" Width="176" Margin="6,0,0,0" Style="{StaticResource InkBar}" />
        </Grid>
        <Border Width="134" Margin="0,0,0,12" Style="{StaticResource Bar}" />
        <Border Width="156" Style="{StaticResource Bar}" />
      </StackPanel>
    </Border>

    <!-- Ctrl+V. -->
    <StackPanel Margin="0,18,0,18" HorizontalAlignment="Center" Orientation="Horizontal">
      <Border Style="{StaticResource KeyCap.Border}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <ScaleTransform x:Name="CtrlScale" />
        </Border.RenderTransform>
        <TextBlock Style="{StaticResource KeyCap.Text}" Text="Ctrl" />
      </Border>
      <Border Style="{StaticResource KeyCap.Border}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <ScaleTransform x:Name="VScale" />
        </Border.RenderTransform>
        <TextBlock Style="{StaticResource KeyCap.Text}" Text="V" />
      </Border>
    </StackPanel>

    <!-- The form field that asks for one thing. -->
    <TextBlock Margin="2,0,0,6" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Email" />
    <Border
      Height="44"
      Background="{DynamicResource ControlFillColorDefaultBrush}"
      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="{DynamicResource ControlCornerRadius}">
      <Grid>
        <Grid Margin="10,0,0,0">
          <Border Width="190" Style="{StaticResource Marker}">
            <Border.RenderTransform>
              <ScaleTransform x:Name="FieldMarkScale" ScaleX="0" />
            </Border.RenderTransform>
          </Border>
          <Border x:Name="FieldValue" Width="176" Margin="6,0,0,0" Opacity="0" Style="{StaticResource Bar}" Background="{DynamicResource Brand.HighlightTextBrush}">
            <Border.RenderTransform>
              <TranslateTransform x:Name="FieldValueShift" X="-8" />
            </Border.RenderTransform>
          </Border>
          <Rectangle
            x:Name="Caret"
            Width="1.5"
            Height="18"
            Margin="4,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Fill="{DynamicResource TextFillColorPrimaryBrush}">
            <Rectangle.RenderTransform>
              <TranslateTransform x:Name="CaretShift" />
            </Rectangle.RenderTransform>
          </Rectangle>
        </Grid>
        <!-- The focus line along the bottom, as in a real text box. -->
        <Border
          Height="2"
          Margin="1,0,1,0"
          VerticalAlignment="Bottom"
          Background="{DynamicResource AccentFillColorDefaultBrush}"
          CornerRadius="0,0,4,4" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
