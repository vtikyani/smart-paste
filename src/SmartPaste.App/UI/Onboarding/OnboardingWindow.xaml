<ui:FluentWindow
  x:Class="SmartPaste.App.UI.Onboarding.OnboardingWindow"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:onboarding="clr-namespace:SmartPaste.App.UI.Onboarding"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=onboarding:OnboardingViewModel}"
  Title="Welcome to Smart Paste"
  Width="760"
  Height="560"
  ExtendsContentIntoTitleBar="True"
  ResizeMode="NoResize"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen">

  <ui:FluentWindow.Resources>
    <ResourceDictionary Source="/SmartPaste;component/UI/Onboarding/OnboardingStyles.xaml" />
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar
      Grid.Row="0"
      CanMaximize="False"
      ShowMaximize="False"
      ShowMinimize="False" />

    <!-- The current step. Code-behind swaps it with a short slide. Steps fit the window; on a very small screen
         they scroll instead of being cut off. -->
    <ScrollViewer
      Grid.Row="1"
      Focusable="False"
      HorizontalScrollBarVisibility="Disabled"
      VerticalScrollBarVisibility="Auto">
      <ContentControl
        x:Name="StepHost"
        Margin="44,0,44,0"
        Focusable="False"
        IsTabStop="False">
        <ContentControl.RenderTransform>
          <TranslateTransform x:Name="StepOffset" />
        </ContentControl.RenderTransform>
      </ContentControl>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="32,8,32,28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ui:Button
        HorizontalAlignment="Left"
        Command="{Binding SkipCommand}"
        Content="Skip tour"
        Style="{StaticResource Settings.QuietButton}"
        Visibility="{Binding CanSkip, Converter={StaticResource Settings.BoolToVisibility}}" />

      <!-- Where you are in the tour. -->
      <ItemsControl
        Grid.Column="1"
        VerticalAlignment="Center"
        AutomationProperties.Name="{Binding StepLabel}"
        Focusable="False"
        ItemsSource="{Binding Dots}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type onboarding:StepDot}">
            <Border Style="{StaticResource Onboarding.Dot}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
        <ui:Button
          MinWidth="88"
          Margin="0,0,8,0"
          Command="{Binding BackCommand}"
          Content="Back"
          Visibility="{Binding CanGoBack, Converter={StaticResource Settings.BoolToVisibility}}" />
        <ui:Button
          x:Name="NextButton"
          MinWidth="120"
          Appearance="Primary"
          Command="{Binding NextCommand}"
          Content="{Binding NextText}" />
      </StackPanel>
    </Grid>

    <ui:InfoBar
      Grid.Row="1"
      MaxWidth="560"
      Margin="0,0,0,12"
      HorizontalAlignment="Center"
      VerticalAlignment="Bottom"
      IsClosable="True"
      IsOpen="{Binding Notice.IsOpen, Mode=TwoWay, FallbackValue=False}"
      Message="{Binding Notice.Message}"
      Severity="{Binding Notice.Severity}"
      Title="{Binding Notice.Title}" />

    <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="3" />
  </Grid>
</ui:FluentWindow>
