<ui:FluentWindow
  x:Class="SmartPaste.App.UI.Settings.SettingsWindow"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pages="clr-namespace:SmartPaste.App.UI.Settings.Pages"
  xmlns:settings="clr-namespace:SmartPaste.App.UI.Settings"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=settings:SettingsViewModel}"
  Title="Smart Paste settings"
  Width="1080"
  Height="720"
  MinWidth="900"
  MinHeight="600"
  Background="{DynamicResource ApplicationBackgroundBrush}"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen">

  <ui:FluentWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SettingsStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The brand lives in the sidebar, so the title bar keeps only the window buttons. -->
    <ui:TitleBar
      x:Name="TitleBar"
      Grid.Row="0"
      CloseWindowByDoubleClickOnIcon="False" />

    <ui:NavigationView
      x:Name="Navigation"
      Grid.Row="1"
      Padding="0"
      FrameMargin="0"
      HeaderVisibility="Collapsed"
      IsBackButtonVisible="Collapsed"
      IsFooterSeparatorVisible="False"
      IsPaneToggleVisible="False"
      IsTopSeparatorVisible="False"
      OpenPaneLength="240"
      PaneDisplayMode="Left"
      Transition="FadeInWithSlide"
      TransitionDuration="200">

      <ui:NavigationView.PaneHeader>
        <StackPanel Margin="20,0,16,16" Orientation="Horizontal">
          <Image Width="26" Height="26" Source="{StaticResource Brand.LogoImage}" />
          <TextBlock
            Margin="10,0,0,0"
            VerticalAlignment="Center"
            FontFamily="{DynamicResource Brand.FontDisplay}"
            FontSize="{DynamicResource Brand.SizeBodyLarge}"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="Smart Paste" />
        </StackPanel>
      </ui:NavigationView.PaneHeader>

      <ui:NavigationView.PaneFooter>
        <!-- Live status: what Smart Paste is doing right now, with a colored dot. Selecting it opens the page that
             explains it. -->
        <Button
          Margin="12,8,12,12"
          Padding="12,9,10,9"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Stretch"
          AutomationProperties.HelpText="{Binding StatusDetail}"
          AutomationProperties.Name="{Binding StatusTitle}"
          Command="{Binding OpenStatusPageCommand}"
          Style="{StaticResource Settings.StatusChip}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="8" Height="8" Margin="2,0,10,0" VerticalAlignment="Center">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{DynamicResource Brand.SuccessBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusTone}" Value="Armed">
                      <Setter Property="Fill" Value="{DynamicResource Brand.MarkBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusTone}" Value="Busy">
                      <Setter Property="Fill" Value="{DynamicResource Brand.AccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusTone}" Value="Paused">
                      <Setter Property="Fill" Value="{DynamicResource Brand.WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusTone}" Value="Off">
                      <Setter Property="Fill" Value="{DynamicResource Brand.Text3Brush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusTone}" Value="Attention">
                      <Setter Property="Fill" Value="{DynamicResource Brand.DangerBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding StatusTitle}"
                TextTrimming="CharacterEllipsis" />
              <TextBlock
                Margin="0,1,0,0"
                Style="{StaticResource Settings.Caption}"
                Text="{Binding StatusDetail}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            </StackPanel>
            <ui:SymbolIcon
              Grid.Column="2"
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              FontSize="14"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Symbol="ChevronRight20" />
          </Grid>
        </Button>
      </ui:NavigationView.PaneFooter>

      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="General" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type pages:GeneralPage}" />
        <ui:NavigationViewItem Content="Jev &amp; AI" Icon="{ui:SymbolIcon Sparkle24}" TargetPageType="{x:Type pages:JevPage}" />
        <ui:NavigationViewItem Content="Privacy" Icon="{ui:SymbolIcon ShieldCheckmark24}" TargetPageType="{x:Type pages:PrivacyPage}" />
        <ui:NavigationViewItem Content="Learned labels" Icon="{ui:SymbolIcon TagMultiple24}" TargetPageType="{x:Type pages:LearnedLabelsPage}" />
        <ui:NavigationViewItem Content="Shortcuts" Icon="{ui:SymbolIcon Keyboard24}" TargetPageType="{x:Type pages:ShortcutsPage}" />
        <ui:NavigationViewItem Content="About" Icon="{ui:SymbolIcon Info24}" TargetPageType="{x:Type pages:AboutPage}" />
      </ui:NavigationView.MenuItems>
    </ui:NavigationView>

    <!-- A hairline between the sidebar and the page, full height. -->
    <Rectangle
      Grid.Row="0"
      Grid.RowSpan="2"
      Width="1"
      Margin="240,0,0,0"
      HorizontalAlignment="Left"
      Fill="{DynamicResource Brand.BorderBrush}"
      IsHitTestVisible="False" />

    <!-- Problems that aren't tied to one control, such as a settings file that couldn't be written. -->
    <ui:InfoBar
      Grid.Row="1"
      MaxWidth="640"
      Margin="0,0,0,20"
      HorizontalAlignment="Center"
      VerticalAlignment="Bottom"
      IsClosable="True"
      IsOpen="{Binding Notice.IsOpen, Mode=TwoWay}"
      Message="{Binding Notice.Message}"
      Severity="{Binding Notice.Severity}"
      Title="{Binding Notice.Title}" />

    <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="2" />
  </Grid>
</ui:FluentWindow>
