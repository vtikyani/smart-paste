<ui:FluentWindow
  x:Class="SmartPaste.App.UI.Settings.SettingsWindow"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pages="clr-namespace:SmartPaste.App.UI.Settings.Pages"
  xmlns:settings="clr-namespace:SmartPaste.App.UI.Settings"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=settings:SettingsViewModel}"
  Title="Smart Paste settings"
  Width="1060"
  Height="740"
  MinWidth="860"
  MinHeight="560"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen">

  <ui:FluentWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SettingsStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar
      x:Name="TitleBar"
      Grid.Row="0"
      Title="Smart Paste"
      CloseWindowByDoubleClickOnIcon="False">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Width="16" Height="16" Source="{DynamicResource Brand.LogoMonoImage}" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <ui:NavigationView
      x:Name="Navigation"
      Grid.Row="1"
      Padding="0"
      FrameMargin="0"
      HeaderVisibility="Collapsed"
      IsBackButtonVisible="Collapsed"
      IsFooterSeparatorVisible="False"
      IsPaneToggleVisible="False"
      IsTopSeparatorVisible="False"
      OpenPaneLength="296"
      PaneDisplayMode="Left"
      Transition="FadeInWithSlide"
      TransitionDuration="180">

      <ui:NavigationView.PaneHeader>
        <!-- Live status: what Smart Paste is doing right now. Selecting it opens the page that explains it. -->
        <ui:Button
          Margin="12,4,12,12"
          Padding="12"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Stretch"
          AutomationProperties.HelpText="{Binding StatusDetail}"
          AutomationProperties.Name="{Binding StatusTitle}"
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
          Command="{Binding OpenStatusPageCommand}"
          CornerRadius="{DynamicResource Brand.RadiusControl}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="StatusTile" Width="36" Height="36" CornerRadius="18" VerticalAlignment="Center">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusTone}" Value="Ready">
                      <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusTone}" Value="Busy">
                      <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusTone}" Value="Armed">
                      <Setter Property="Background" Value="{DynamicResource Brand.HighlightFillBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusTone}" Value="Attention">
                      <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <ui:SymbolIcon FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon.Style>
                  <Style TargetType="ui:SymbolIcon">
                    <Setter Property="Symbol" Value="Checkmark24" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding StatusTone}" Value="Busy">
                        <Setter Property="Symbol" Value="ArrowSync24" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding StatusTone}" Value="Armed">
                        <Setter Property="Symbol" Value="ClipboardPaste24" />
                        <Setter Property="Foreground" Value="{DynamicResource Brand.HighlightTextBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding StatusTone}" Value="Paused">
                        <Setter Property="Symbol" Value="Pause24" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding StatusTone}" Value="Off">
                        <Setter Property="Symbol" Value="Power24" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding StatusTone}" Value="Attention">
                        <Setter Property="Symbol" Value="Warning24" />
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:SymbolIcon.Style>
              </ui:SymbolIcon>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock
                FontSize="{DynamicResource Brand.SizeBody}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding StatusTitle}"
                TextTrimming="CharacterEllipsis" />
              <TextBlock
                Margin="0,1,0,0"
                Style="{StaticResource Settings.Caption}"
                Text="{Binding StatusDetail}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            </StackPanel>
          </Grid>
        </ui:Button>
      </ui:NavigationView.PaneHeader>

      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="General" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type pages:GeneralPage}" />
        <ui:NavigationViewItem Content="Jev &amp; AI" Icon="{ui:SymbolIcon Sparkle24}" TargetPageType="{x:Type pages:JevPage}" />
        <ui:NavigationViewItem Content="Privacy" Icon="{ui:SymbolIcon ShieldCheckmark24}" TargetPageType="{x:Type pages:PrivacyPage}" />
        <ui:NavigationViewItem Content="Learned labels" Icon="{ui:SymbolIcon TagMultiple24}" TargetPageType="{x:Type pages:LearnedLabelsPage}" />
        <ui:NavigationViewItem Content="Shortcuts" Icon="{ui:SymbolIcon Keyboard24}" TargetPageType="{x:Type pages:ShortcutsPage}" />
        <ui:NavigationViewItem Content="About" Icon="{ui:SymbolIcon Info24}" TargetPageType="{x:Type pages:AboutPage}" />
      </ui:NavigationView.MenuItems>
    </ui:NavigationView>

    <!-- Problems that aren't tied to one control, such as a settings file that couldn't be written. -->
    <ui:InfoBar
      Grid.Row="1"
      MaxWidth="640"
      Margin="0,0,0,20"
      HorizontalAlignment="Center"
      VerticalAlignment="Bottom"
      IsClosable="True"
      IsOpen="{Binding Notice.IsOpen, Mode=TwoWay}"
      Message="{Binding Notice.Message}"
      Severity="{Binding Notice.Severity}"
      Title="{Binding Notice.Title}" />

    <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="2" />
  </Grid>
</ui:FluentWindow>
