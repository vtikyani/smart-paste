<Page
  x:Class="SmartPaste.App.UI.Settings.Pages.AboutPage"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pages="clr-namespace:SmartPaste.App.UI.Settings.Pages"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=pages:AboutViewModel}"
  Title="About">

  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SmartPaste;component/UI/Settings/SettingsStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="LinkCard" TargetType="ui:CardAction" BasedOn="{StaticResource {x:Type ui:CardAction}}">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="16,14,16,14" />
        <Setter Property="IsChevronVisible" Value="False" />
      </Style>
    </ResourceDictionary>
  </Page.Resources>

  <StackPanel Style="{StaticResource Settings.Page}">
    <TextBlock Style="{StaticResource Settings.PageTitle}" Text="About" />

    <!-- Who we are, which version this is, and whether it's the newest. -->
    <Border Margin="0,18,0,4" Padding="0" CornerRadius="{DynamicResource Brand.RadiusCard}" Style="{StaticResource Settings.Panel}">
      <StackPanel>
        <Grid Margin="24,22,22,22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image
            Width="56"
            Height="56"
            VerticalAlignment="Center"
            RenderOptions.BitmapScalingMode="HighQuality"
            Source="{DynamicResource Brand.LogoImage}" />
          <StackPanel Grid.Column="1" Margin="20,0,16,0" VerticalAlignment="Center">
            <TextBlock
              FontFamily="{DynamicResource Brand.FontDisplay}"
              FontSize="{DynamicResource Brand.SizeSubtitle}"
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="Smart Paste" />
            <TextBlock Margin="0,2,0,0" Style="{StaticResource Settings.Caption}">
              <Run Text="Version" />
              <Run Text="{Binding Version, Mode=OneWay}" />
            </TextBlock>
            <TextBlock
              Margin="0,8,0,0"
              FontSize="{DynamicResource Brand.SizeBody}"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="Paste the right thing into every field."
              TextWrapping="Wrap" />
          </StackPanel>
          <Grid Grid.Column="2" VerticalAlignment="Center">
            <ui:ProgressRing
              Width="20"
              Height="20"
              Margin="0,0,16,0"
              IsIndeterminate="True"
              Visibility="{Binding IsChecking, Converter={StaticResource Settings.BoolToVisibility}}" />
            <ui:Button
              Command="{Binding CheckCommand}"
              Content="{Binding CheckText}"
              Icon="{ui:SymbolIcon ArrowSync24}"
              Visibility="{Binding CanCheck, Converter={StaticResource Settings.BoolToVisibility}}" />
          </Grid>
        </Grid>

        <!-- The latest word on updates. -->
        <Border
          Padding="24,14,22,14"
          AutomationProperties.LiveSetting="Polite"
          BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
          BorderThickness="0,1,0,0"
          Visibility="{Binding UpdateMessage, Converter={StaticResource Settings.TextToVisible}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Margin="0,0,12,0" VerticalAlignment="Center" FontSize="18" Filled="True">
              <ui:SymbolIcon.Style>
                <Style TargetType="ui:SymbolIcon">
                  <Setter Property="Symbol" Value="Info24" />
                  <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Stage}" Value="UpToDate">
                      <Setter Property="Symbol" Value="CheckmarkCircle24" />
                      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Stage}" Value="Available">
                      <Setter Property="Symbol" Value="ArrowDownload24" />
                      <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Stage}" Value="Downloading">
                      <Setter Property="Symbol" Value="ArrowDownload24" />
                      <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Stage}" Value="Failed">
                      <Setter Property="Symbol" Value="ErrorCircle24" />
                      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Settings.CardTitle}" Text="{Binding UpdateMessage}" />
              <Grid Margin="0,10,0,2" Visibility="{Binding IsDownloading, Converter={StaticResource Settings.BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MaxWidth="360" />
                  <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <ProgressBar VerticalAlignment="Center" Maximum="100" Value="{Binding DownloadPercent, Mode=OneWay}" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource Settings.Caption}" Text="{Binding DownloadPercent, StringFormat={}{0}%}" />
              </Grid>
            </StackPanel>
            <ui:Button
              Grid.Column="2"
              Margin="16,0,0,0"
              Appearance="Primary"
              Command="{Binding InstallCommand}"
              Content="Download and restart"
              Visibility="{Binding CanInstall, Converter={StaticResource Settings.BoolToVisibility}}" />
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <ui:CardControl Icon="{ui:SymbolIcon Clock24}" Style="{StaticResource Settings.Card}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource Settings.CardTitle}" Text="Check for updates automatically" />
          <TextBlock Style="{StaticResource Settings.CardDescription}" Text="Smart Paste lets you know when a new version is out. It never installs one without you." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch
        AutomationProperties.Name="Check for updates automatically"
        IsChecked="{Binding CheckForUpdates}"
        OffContent="Off"
        OnContent="On" />
    </ui:CardControl>

    <TextBlock Style="{StaticResource Settings.SectionHeader}" Text="Get started again" />
    <ui:CardAction Command="{Binding ShowWelcomeTourCommand}" Icon="{ui:SymbolIcon HandWave24}" IsChevronVisible="True" Style="{StaticResource LinkCard}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.CardTitle}" Text="Show the welcome tour again" />
        <TextBlock Style="{StaticResource Settings.CardDescription}" Text="A short walk through Smart Paste, with a form to practice on." />
      </StackPanel>
    </ui:CardAction>

    <StackPanel Visibility="{Binding HasRepository, Converter={StaticResource Settings.BoolToVisibility}}">
      <TextBlock Style="{StaticResource Settings.SectionHeader}" Text="Open source" />
      <ui:CardAction Command="{Binding OpenSourceCommand}" Icon="{ui:SymbolIcon Code24}" Style="{StaticResource LinkCard}">
        <Grid>
          <TextBlock VerticalAlignment="Center" Style="{StaticResource Settings.CardTitle}" Text="Source code" />
          <ui:SymbolIcon HorizontalAlignment="Right" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Open16" />
        </Grid>
      </ui:CardAction>
      <ui:CardAction Command="{Binding OpenPrivacyCommand}" Icon="{ui:SymbolIcon ShieldCheckmark24}" Style="{StaticResource LinkCard}">
        <Grid>
          <TextBlock VerticalAlignment="Center" Style="{StaticResource Settings.CardTitle}" Text="Privacy statement" />
          <ui:SymbolIcon HorizontalAlignment="Right" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Open16" />
        </Grid>
      </ui:CardAction>
      <ui:CardAction Command="{Binding OpenLicensesCommand}" Icon="{ui:SymbolIcon DocumentText24}" Style="{StaticResource LinkCard}">
        <Grid>
          <TextBlock VerticalAlignment="Center" Style="{StaticResource Settings.CardTitle}" Text="Third-party licenses" />
          <ui:SymbolIcon HorizontalAlignment="Right" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Open16" />
        </Grid>
      </ui:CardAction>
      <ui:CardAction Command="{Binding ReportProblemCommand}" Icon="{ui:SymbolIcon Bug24}" Style="{StaticResource LinkCard}">
        <Grid>
          <TextBlock VerticalAlignment="Center" Style="{StaticResource Settings.CardTitle}" Text="Report a problem" />
          <ui:SymbolIcon HorizontalAlignment="Right" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Open16" />
        </Grid>
      </ui:CardAction>
    </StackPanel>

    <TextBlock Margin="2,28,0,0" Style="{StaticResource Settings.Caption}" Text="{Binding Copyright}" />
  </StackPanel>
</Page>
