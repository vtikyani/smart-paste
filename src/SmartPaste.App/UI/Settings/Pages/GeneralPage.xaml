<Page
  x:Class="SmartPaste.App.UI.Settings.Pages.GeneralPage"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pages="clr-namespace:SmartPaste.App.UI.Settings.Pages"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=pages:GeneralViewModel}"
  Title="General">

  <Page.Resources>
    <ResourceDictionary Source="/SmartPaste;component/UI/Settings/SettingsStyles.xaml" />
  </Page.Resources>

  <StackPanel Style="{StaticResource Settings.Page}">
    <TextBlock Style="{StaticResource Settings.PageTitle}" Text="General" />

    <ui:CardControl Margin="0,18,0,4" Icon="{ui:SymbolIcon Power24}" Style="{StaticResource Settings.Card}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource Settings.CardTitle}" Text="Smart Paste" />
          <TextBlock Style="{StaticResource Settings.CardDescription}" Text="{Binding EnabledDescription}" />
        </StackPanel>
      </ui:CardControl.Header>
      <StackPanel Orientation="Horizontal">
        <ui:Button
          Margin="0,0,16,0"
          Appearance="Primary"
          Command="{Binding ResumeCommand}"
          Content="Resume"
          Visibility="{Binding IsPaused, Converter={StaticResource Settings.BoolToVisibility}}" />
        <ui:ToggleSwitch
          AutomationProperties.Name="Smart Paste"
          IsChecked="{Binding IsEnabled}"
          OffContent="Off"
          OnContent="On" />
      </StackPanel>
    </ui:CardControl>

    <TextBlock Style="{StaticResource Settings.SectionHeader}" Text="Startup and look" />

    <ui:CardControl Icon="{ui:SymbolIcon Rocket24}" Style="{StaticResource Settings.Card}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource Settings.CardTitle}" Text="Start when I sign in" />
          <TextBlock Style="{StaticResource Settings.CardDescription}" Text="Smart Paste starts quietly in the tray each time you sign in to Windows." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch
        AutomationProperties.Name="Start when I sign in"
        IsChecked="{Binding StartAtLogin}"
        OffContent="Off"
        OnContent="On" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon DarkTheme24}" Style="{StaticResource Settings.Card}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource Settings.CardTitle}" Text="Theme" />
          <TextBlock Style="{StaticResource Settings.CardDescription}" Text="Light or dark, or follow Windows." />
        </StackPanel>
      </ui:CardControl.Header>
      <ComboBox
        MinWidth="220"
        AutomationProperties.Name="Theme"
        DisplayMemberPath="Label"
        ItemsSource="{Binding Themes}"
        SelectedItem="{Binding SelectedTheme}" />
    </ui:CardControl>

    <TextBlock Style="{StaticResource Settings.SectionHeader}" Text="Pasting" />

    <ui:CardControl Icon="{ui:SymbolIcon Timer24}" Style="{StaticResource Settings.Card}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource Settings.CardTitle}" Text="Keep a copied block ready for" />
          <TextBlock Style="{StaticResource Settings.CardDescription}" Text="After this, Smart Paste forgets the block. Copying something new replaces it sooner." />
        </StackPanel>
      </ui:CardControl.Header>
      <ComboBox
        MinWidth="220"
        AutomationProperties.Name="Keep a copied block ready for"
        DisplayMemberPath="Label"
        ItemsSource="{Binding Lifetimes}"
        SelectedItem="{Binding SelectedLifetime}" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon TextField24}" Style="{StaticResource Settings.Card}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource Settings.CardTitle}" Text="Show what Ctrl+V will paste" />
          <TextBlock Style="{StaticResource Settings.CardDescription}" Text="A small hint appears next to the field you're in." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch
        AutomationProperties.Name="Show what Ctrl+V will paste"
        IsChecked="{Binding ShowFieldHints}"
        OffContent="Off"
        OnContent="On" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon CheckmarkCircle24}" Style="{StaticResource Settings.Card}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource Settings.CardTitle}" Text="Confirm each smart paste" />
          <TextBlock Style="{StaticResource Settings.CardDescription}" Text="A brief note, like &quot;Pasted: First name&quot;, appears after each one." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch
        AutomationProperties.Name="Confirm each smart paste"
        IsChecked="{Binding ShowPasteConfirmation}"
        OffContent="Off"
        OnContent="On" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon Alert24}" Style="{StaticResource Settings.Card}">
      <ui:CardControl.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource Settings.CardTitle}" Text="Notify me when a block is ready" />
          <TextBlock Style="{StaticResource Settings.CardDescription}" Text="A Windows notification lets you know you can start pasting." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch
        AutomationProperties.Name="Notify me when a block is ready"
        IsChecked="{Binding NotifyWhenArmed}"
        OffContent="Off"
        OnContent="On" />
    </ui:CardControl>
  </StackPanel>
</Page>
