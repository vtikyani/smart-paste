<Page
  x:Class="SmartPaste.App.UI.Settings.Pages.LearnedLabelsPage"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:pages="clr-namespace:SmartPaste.App.UI.Settings.Pages"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=pages:LearnedLabelsViewModel}"
  Title="Learned labels">

  <Page.Resources>
    <ResourceDictionary Source="/SmartPaste;component/UI/Settings/SettingsStyles.xaml" />
  </Page.Resources>

  <StackPanel Style="{StaticResource Settings.Page}">
    <TextBlock Style="{StaticResource Settings.PageTitle}" Text="Learned labels" />
    <TextBlock Style="{StaticResource Settings.PageIntro}" Text="When Jev decides a field, or you pick a value yourself, Smart Paste remembers that field's label on this PC. It uses these labels when Jev can't be reached." />

    <!-- Count, filter, and Forget all. -->
    <Grid Margin="0,28,0,10" Visibility="{Binding HasLabels, Converter={StaticResource Settings.BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock
        Margin="2,0,0,0"
        VerticalAlignment="Center"
        FontSize="{DynamicResource Brand.SizeBody}"
        FontWeight="SemiBold"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Text="{Binding CountText}" />
      <ui:TextBox
        Grid.Column="1"
        Width="240"
        AutomationProperties.Name="Find a label"
        Icon="{ui:SymbolIcon Search24}"
        IconPlacement="Left"
        PlaceholderText="Find a label"
        Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
      <ui:Button
        Grid.Column="2"
        Margin="8,0,0,0"
        VerticalAlignment="Stretch"
        Command="{Binding ForgetAllCommand}"
        Content="Forget all"
        Icon="{ui:SymbolIcon Delete24}" />
    </Grid>

    <Border Padding="0,0,0,0" Style="{StaticResource Settings.Panel}" Visibility="{Binding HasLabels, Converter={StaticResource Settings.BoolToVisibility}}">
      <StackPanel>
        <ItemsControl Focusable="False" ItemsSource="{Binding Labels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type pages:LearnedLabelRow}">
              <Border x:Name="Row" Style="{StaticResource Settings.ListRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource Settings.CardTitle}"
                    Text="{Binding Label}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    ToolTip="{Binding Label}" />
                  <ui:SymbolIcon
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Symbol="ArrowRight24" />
                  <Border Grid.Column="2" Style="{StaticResource Settings.Pill}">
                    <TextBlock Style="{StaticResource Settings.PillText}" Text="{Binding Kind}" />
                  </Border>
                  <ui:Button
                    Grid.Column="3"
                    AutomationProperties.Name="{Binding Label, StringFormat='Forget {0}'}"
                    Command="{Binding DataContext.ForgetCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                    CommandParameter="{Binding}"
                    Content="Forget" />
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                  <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock
          Margin="16,14,16,16"
          Style="{StaticResource Settings.Caption}"
          Text="No labels match. Try a different word."
          Visibility="{Binding HasNoMatches, Converter={StaticResource Settings.BoolToVisibility}}" />
      </StackPanel>
    </Border>

    <!-- Nothing learned yet: say what will appear here and why it's useful. -->
    <Border
      Margin="0,28,0,0"
      Padding="32,36,32,40"
      CornerRadius="{DynamicResource Brand.RadiusCard}"
      Style="{StaticResource Settings.Panel}"
      Visibility="{Binding IsEmpty, Converter={StaticResource Settings.BoolToVisibility}}">
      <StackPanel MaxWidth="420" HorizontalAlignment="Center">
        <Border Width="52" Height="52" HorizontalAlignment="Center" CornerRadius="{DynamicResource Brand.RadiusCard}" Style="{StaticResource Settings.HighlighterTile}">
          <ui:SymbolIcon
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="26"
            Foreground="{DynamicResource Brand.HighlightTextBrush}"
            Symbol="Tag24" />
        </Border>
        <TextBlock
          Margin="0,18,0,0"
          HorizontalAlignment="Center"
          FontFamily="{DynamicResource Brand.FontDisplay}"
          FontSize="{DynamicResource Brand.SizeSubtitle}"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
          Text="Nothing learned yet" />
        <TextBlock
          Margin="0,8,0,0"
          HorizontalAlignment="Center"
          Style="{StaticResource Settings.PageIntro}"
          Text="As you paste into forms, the labels Smart Paste learns show up here. You can forget any of them."
          TextAlignment="Center" />
      </StackPanel>
    </Border>
  </StackPanel>
</Page>
