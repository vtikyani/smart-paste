<popups:PopupWindow
  x:Class="SmartPaste.App.UI.Popups.PickerWindow"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:SmartPaste.App.UI.Controls"
  xmlns:popups="clr-namespace:SmartPaste.App.UI.Popups"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Smart Paste: choose a value">

  <!-- The margin is room for the shadow, deeper below than above as if lit from the top. -->
  <Grid Margin="18,10,18,26" Opacity="0">
    <Grid.RenderTransform>
      <TranslateTransform />
    </Grid.RenderTransform>

    <Border Background="{DynamicResource Brand.PopupSurfaceBrush}" CornerRadius="{StaticResource Brand.RadiusPopup}">
      <Border.Effect>
        <DropShadowEffect
          BlurRadius="28"
          Direction="270"
          Opacity="{DynamicResource Brand.ShadowOpacity}"
          RenderingBias="Quality"
          ShadowDepth="8"
          Color="Black" />
      </Border.Effect>
    </Border>

    <Border
      x:Name="Panel"
      MinWidth="264"
      MaxWidth="360"
      Background="{DynamicResource Brand.PopupSurfaceBrush}"
      BorderBrush="{DynamicResource Brand.PopupBorderBrush}"
      BorderThickness="1"
      CornerRadius="{StaticResource Brand.RadiusPopup}"
      TextElement.FontFamily="{StaticResource Brand.FontText}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
          Margin="16,13,16,8"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{DynamicResource Brand.PopupTextBrush}"
          Text="{Binding Title}"
          TextTrimming="CharacterEllipsis" />

        <!-- "All values" mode: what the user has typed so far narrows the list. -->
        <Border
          Grid.Row="1"
          Height="30"
          Margin="12,0,12,6"
          Padding="8,0"
          Background="{DynamicResource Brand.PopupHoverBrush}"
          CornerRadius="6"
          Visibility="{Binding IsFilterable, Converter={StaticResource SmartPaste.VisibleWhen}}">
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <ui:SymbolIcon
              FontSize="14"
              Foreground="{DynamicResource Brand.PopupSubtleTextBrush}"
              Symbol="Search16" />
            <TextBlock
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              FontSize="13"
              Foreground="{DynamicResource Brand.PopupTextBrush}"
              Text="{Binding Filter}"
              Visibility="{Binding HasFilter, Converter={StaticResource SmartPaste.VisibleWhen}}" />
            <Rectangle
              Width="1.5"
              Height="15"
              Margin="1,0,0,0"
              VerticalAlignment="Center"
              Fill="{DynamicResource Brand.PopupTextBrush}" />
            <TextBlock
              Margin="6,0,0,0"
              VerticalAlignment="Center"
              FontSize="13"
              Foreground="{DynamicResource Brand.PopupSubtleTextBrush}"
              Text="Type to filter"
              Visibility="{Binding HasFilter, Converter={StaticResource SmartPaste.VisibleWhen}, ConverterParameter=Not}" />
          </StackPanel>
        </Border>

        <Grid Grid.Row="2">
          <ScrollViewer
            x:Name="Scroller"
            MaxHeight="324"
            Padding="6,0,6,6"
            Focusable="False"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl
              x:Name="List"
              Focusable="False"
              ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border
                    x:Name="Row"
                    Margin="0,1"
                    Padding="10,7,12,7"
                    AutomationProperties.Name="{Binding SpokenText}"
                    Background="Transparent"
                    CornerRadius="8"
                    MouseLeftButtonUp="OnRowClicked">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <controls:KeyCap
                        Margin="0,1,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Text="{Binding Number}"
                        Visibility="{Binding HasNumber, Converter={StaticResource SmartPaste.VisibleWhen}}" />
                      <StackPanel Grid.Column="1">
                        <controls:HighlighterMark
                          x:Name="Mark"
                          Margin="-5,0,0,0"
                          HorizontalAlignment="Left"
                          Padding="5,0,6,1">
                          <TextBlock
                            x:Name="ValueText"
                            FontSize="14"
                            Foreground="{DynamicResource Brand.PopupTextBrush}"
                            Text="{Binding Value}"
                            TextTrimming="CharacterEllipsis" />
                        </controls:HighlighterMark>
                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                          <TextBlock
                            x:Name="FieldName"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource Brand.PopupSubtleTextBrush}"
                            Text="{Binding Name}" />
                          <Border
                            Height="18"
                            Margin="8,0,0,0"
                            Padding="7,0"
                            VerticalAlignment="Center"
                            BorderBrush="{DynamicResource Brand.PopupDividerBrush}"
                            controls:Pill.IsPill="True"
                            BorderThickness="1"
                            Visibility="{Binding Entity, Converter={StaticResource SmartPaste.VisibleWhen}}">
                            <TextBlock
                              VerticalAlignment="Center"
                              FontSize="11"
                              Foreground="{DynamicResource Brand.PopupSubtleTextBrush}"
                              Text="{Binding Entity}" />
                          </Border>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brand.PopupHoverBrush}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brand.PopupSelectedBrush}" />
                      <Setter TargetName="Mark" Property="Fill" Value="{DynamicResource Brand.HighlightFillBrush}" />
                      <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource Brand.HighlightTextBrush}" />
                      <Setter TargetName="FieldName" Property="Foreground" Value="{DynamicResource Brand.PopupSelectedTextBrush}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock
            Margin="16,4,16,12"
            FontSize="13"
            Foreground="{DynamicResource Brand.PopupSubtleTextBrush}"
            Text="No value matches."
            Visibility="{Binding HasNoMatch, Converter={StaticResource SmartPaste.VisibleWhen}}" />
        </Grid>

        <Border
          Grid.Row="3"
          Padding="16,8,16,9"
          BorderBrush="{DynamicResource Brand.PopupDividerBrush}"
          BorderThickness="0,1,0,0">
          <StackPanel Orientation="Horizontal">
            <controls:KeyCap Text="Esc" />
            <TextBlock
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{DynamicResource Brand.PopupSubtleTextBrush}"
              Text="{Binding EscapeHint}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</popups:PopupWindow>
