<!--
  Keycaps: one key name ("Ctrl", "V") on a small raised cap. Used by the shortcut recorder and anywhere a page
  shows a keyboard shortcut, so every shortcut in the app looks the same.
-->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="KeyCap.Border" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brand.KeyCapBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="7,1,7,2" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="KeyCap.Text" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Brand.FontText}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <DataTemplate x:Key="KeyCap.Template">
    <Border Style="{StaticResource KeyCap.Border}">
      <TextBlock Style="{StaticResource KeyCap.Text}" Text="{Binding}" />
    </Border>
  </DataTemplate>

  <ItemsPanelTemplate x:Key="KeyCap.Panel">
    <StackPanel Orientation="Horizontal" />
  </ItemsPanelTemplate>

  <!-- A row of keycaps: set ItemsSource to the key names. -->
  <Style x:Key="KeyCap.Row" TargetType="ItemsControl">
    <Setter Property="ItemTemplate" Value="{StaticResource KeyCap.Template}" />
    <Setter Property="ItemsPanel" Value="{StaticResource KeyCap.Panel}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
