<!--
  Smart Paste design tokens that do not change with light/dark theme. The design language is Whisp's (the sibling
  app): calm and neutral, near-black first, with one expressive element, the opal gradient, kept for the logo, the
  active sidebar marker, the moment a value lands, and progress. Controls use one solid accent, periwinkle, set by
  the theme service. Text never sits on the gradient.
  Theme-dependent brushes live in Brand.Light.xaml / Brand.Dark.xaml / Brand.HighContrast.xaml under the same
  keys; use DynamicResource for those.
-->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime"
  xmlns:brand="clr-namespace:SmartPaste.App.UI.Brand">

  <!-- The opal gradient: ice, periwinkle, orchid, blush. -->
  <Color x:Key="Brand.OpalIceColor">#67E8F9</Color>
  <Color x:Key="Brand.OpalPeriwinkleColor">#818CF8</Color>
  <Color x:Key="Brand.OpalOrchidColor">#C084FC</Color>
  <Color x:Key="Brand.OpalBlushColor">#F9A8D4</Color>

  <!-- Left to right, slightly tilted like Whisp's 100 degree CSS gradient. -->
  <LinearGradientBrush x:Key="Brand.OpalBrush" StartPoint="0,0.4" EndPoint="1,0.6">
    <GradientStop Offset="0" Color="{StaticResource Brand.OpalIceColor}" />
    <GradientStop Offset="0.35" Color="{StaticResource Brand.OpalPeriwinkleColor}" />
    <GradientStop Offset="0.65" Color="{StaticResource Brand.OpalOrchidColor}" />
    <GradientStop Offset="1" Color="{StaticResource Brand.OpalBlushColor}" />
  </LinearGradientBrush>

  <!-- Bottom to top, for thin vertical marks such as the active sidebar item. -->
  <LinearGradientBrush x:Key="Brand.OpalVerticalBrush" StartPoint="0,1" EndPoint="0,0">
    <GradientStop Offset="0" Color="{StaticResource Brand.OpalIceColor}" />
    <GradientStop Offset="0.35" Color="{StaticResource Brand.OpalPeriwinkleColor}" />
    <GradientStop Offset="0.65" Color="{StaticResource Brand.OpalOrchidColor}" />
    <GradientStop Offset="1" Color="{StaticResource Brand.OpalBlushColor}" />
  </LinearGradientBrush>

  <!-- The full-color mark (clipboard, opal-highlighted line, caret) on a square frame. Resolution independent. -->
  <DrawingImage x:Key="Brand.LogoImage" Drawing="{x:Static brand:BrandArt.Logo}" />

  <!-- Shape: 8 controls, 12 cards, 16 panels, pills. -->
  <CornerRadius x:Key="Brand.RadiusSmall">6</CornerRadius>
  <CornerRadius x:Key="Brand.RadiusControl">8</CornerRadius>
  <CornerRadius x:Key="Brand.RadiusCard">12</CornerRadius>
  <CornerRadius x:Key="Brand.RadiusPopup">16</CornerRadius>
  <!-- WPF-UI's own control radius (buttons, text boxes, combo boxes), raised from 4 to match. -->
  <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
  <!-- WPF shares an oversized radius out per side, so on a Border that is wider than tall this draws an ellipse,
       not a pill. For true pills set controls:Pill.IsPill="True" on the Border instead. -->
  <CornerRadius x:Key="Brand.RadiusPill">999</CornerRadius>

  <!-- Spacing (4-point grid) -->
  <Thickness x:Key="Brand.PadXS">4</Thickness>
  <Thickness x:Key="Brand.PadS">8</Thickness>
  <Thickness x:Key="Brand.PadM">12</Thickness>
  <Thickness x:Key="Brand.PadL">16</Thickness>
  <Thickness x:Key="Brand.PadXL">24</Thickness>
  <Thickness x:Key="Brand.PadXXL">32</Thickness>

  <!-- Type: Inter, bundled (Assets/Fonts), with Inter Display for large titles. Windows' own UI font fills in any
       character Inter doesn't have. WPF-UI's controls use the same family through its own key. -->
  <FontFamily x:Key="Brand.FontText">/SmartPaste;component/Assets/Fonts/#Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Brand.FontDisplay">/SmartPaste;component/Assets/Fonts/#Inter Display, Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="ContentControlThemeFontFamily">/SmartPaste;component/Assets/Fonts/#Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Brand.FontMono">Cascadia Mono, Consolas</FontFamily>
  <sys:Double x:Key="Brand.SizeCaption">12</sys:Double>
  <sys:Double x:Key="Brand.SizeBody">14</sys:Double>
  <sys:Double x:Key="Brand.SizeBodyLarge">16</sys:Double>
  <sys:Double x:Key="Brand.SizeSubtitle">20</sys:Double>
  <sys:Double x:Key="Brand.SizeTitle">28</sys:Double>
  <sys:Double x:Key="Brand.SizeHero">40</sys:Double>

  <!-- Motion: short and calm. 120 ms for hover and press, 200 ms for state changes, 320 ms for panels. Enter with
       a decelerating curve, leave faster than you came. -->
  <Duration x:Key="Brand.DurationFast">0:0:0.12</Duration>
  <Duration x:Key="Brand.DurationNormal">0:0:0.2</Duration>
  <Duration x:Key="Brand.DurationSlow">0:0:0.32</Duration>
  <sys:Double x:Key="Brand.EnterOffset">8</sys:Double>
  <QuinticEase x:Key="Brand.EaseOut" EasingMode="EaseOut" />
  <CubicEase x:Key="Brand.EaseIn" EasingMode="EaseIn" />
</ResourceDictionary>
