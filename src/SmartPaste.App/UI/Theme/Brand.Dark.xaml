<!-- Brand brushes for the dark theme. Same keys as Brand.Light.xaml and Brand.HighContrast.xaml; reference them
     with DynamicResource. -->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime"
  xmlns:brand="clr-namespace:SmartPaste.App.UI.Brand">

  <SolidColorBrush x:Key="Brand.HighlightFillBrush" Color="#FFD43B" />
  <SolidColorBrush x:Key="Brand.HighlightTextBrush" Color="#15171F" />
  <SolidColorBrush x:Key="Brand.HighlightWashBrush" Color="#2E2A1A" />

  <SolidColorBrush x:Key="Brand.PopupSurfaceBrush" Color="#25272E" />
  <SolidColorBrush x:Key="Brand.PopupBorderBrush" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="Brand.PopupTextBrush" Color="#F4F5F7" />
  <SolidColorBrush x:Key="Brand.PopupSubtleTextBrush" Color="#A3A8B4" />
  <SolidColorBrush x:Key="Brand.PopupHoverBrush" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="Brand.PopupSelectedBrush" Color="#17FFFFFF" />
  <SolidColorBrush x:Key="Brand.PopupSelectedTextBrush" Color="#F4F5F7" />
  <SolidColorBrush x:Key="Brand.PopupDividerBrush" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="Brand.KeyCapBrush" Color="#363944" />
  <SolidColorBrush x:Key="Brand.KeyCapBorderBrush" Color="#1E2027" />
  <SolidColorBrush x:Key="Brand.KeyCapTextBrush" Color="#DADDE3" />
  <Color x:Key="Brand.ShadowColor">#80000000</Color>
  <sys:Double x:Key="Brand.ShadowOpacity">0.5</sys:Double>

  <SolidColorBrush x:Key="Brand.MarkBrush" Color="#FFD43B" />
  <SolidColorBrush x:Key="Brand.OnMarkBrush" Color="#15171F" />

  <SolidColorBrush x:Key="Brand.FlyoutFooterBrush" Color="#29000000" />

  <SolidColorBrush x:Key="Brand.SuccessBrush" Color="#4ADE80" />
  <SolidColorBrush x:Key="Brand.WarningBrush" Color="#FBBF24" />
  <SolidColorBrush x:Key="Brand.DangerBrush" Color="#F87171" />

  <SolidColorBrush x:Key="Brand.LogoGlyphBrush" Color="#FFFFFF" />
  <DrawingImage x:Key="Brand.LogoMonoImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z" />
        <GeometryDrawing Brush="{StaticResource Brand.LogoGlyphBrush}" Geometry="{x:Static brand:BrandArt.Glyph}" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>
