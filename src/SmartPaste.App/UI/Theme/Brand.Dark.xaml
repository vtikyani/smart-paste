<!-- Brand brushes for the dark theme, Whisp's palette. Same keys as Brand.Light.xaml and Brand.HighContrast.xaml;
     reference them with DynamicResource. The second half replaces WPF-UI's own theme brushes, so its controls (cards,
     buttons, text boxes, the sidebar) wear the same neutrals. The accent colors come from the theme service. -->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime"
  xmlns:brand="clr-namespace:SmartPaste.App.UI.Brand">

  <!-- Neutrals: background, three surfaces, hairline borders, three text levels. -->
  <SolidColorBrush x:Key="Brand.BackgroundBrush" Color="#0B0B0E" />
  <SolidColorBrush x:Key="Brand.Surface1Brush" Color="#121216" />
  <SolidColorBrush x:Key="Brand.Surface2Brush" Color="#18181E" />
  <SolidColorBrush x:Key="Brand.Surface3Brush" Color="#202028" />
  <SolidColorBrush x:Key="Brand.BorderBrush" Color="#12FFFFFF" />
  <SolidColorBrush x:Key="Brand.BorderStrongBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="Brand.Text1Brush" Color="#F4F4F6" />
  <SolidColorBrush x:Key="Brand.Text2Brush" Color="#B3B3BD" />
  <SolidColorBrush x:Key="Brand.Text3Brush" Color="#82828D" />
  <SolidColorBrush x:Key="Brand.AccentBrush" Color="#8B9BFF" />
  <SolidColorBrush x:Key="Brand.AccentSoftBrush" Color="#298B9BFF" />
  <SolidColorBrush x:Key="Brand.TrackBrush" Color="#14FFFFFF" />
  <!-- The primary button: inverse colors, with the opal glow behind it. -->
  <SolidColorBrush x:Key="Brand.InverseBrush" Color="#F4F4F6" />
  <SolidColorBrush x:Key="Brand.OnInverseBrush" Color="#0B0B0E" />
  <sys:Double x:Key="Brand.GlowOpacity">0.42</sys:Double>
  <sys:Double x:Key="Brand.GlowHoverOpacity">0.58</sys:Double>

  <!-- The chosen value, behind its text: a periwinkle selection, never the gradient (text never sits on it). -->
  <SolidColorBrush x:Key="Brand.HighlightFillBrush" Color="#528B9BFF" />
  <SolidColorBrush x:Key="Brand.HighlightTextBrush" Color="#F4F4F6" />
  <!-- Soft accent wash for selected rows and the card that holds the armed block. -->
  <SolidColorBrush x:Key="Brand.HighlightWashBrush" Color="#298B9BFF" />

  <!-- Floating surfaces (picker, chips): Whisp's dark glass. They never take focus, so no system backdrop. -->
  <SolidColorBrush x:Key="Brand.PopupSurfaceBrush" Color="#F20E0E12" />
  <SolidColorBrush x:Key="Brand.PopupBorderBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="Brand.PopupTextBrush" Color="#F4F4F6" />
  <SolidColorBrush x:Key="Brand.PopupSubtleTextBrush" Color="#B3B3BD" />
  <SolidColorBrush x:Key="Brand.PopupHoverBrush" Color="#0DFFFFFF" />
  <SolidColorBrush x:Key="Brand.PopupSelectedBrush" Color="#298B9BFF" />
  <SolidColorBrush x:Key="Brand.PopupSelectedTextBrush" Color="#F4F4F6" />
  <SolidColorBrush x:Key="Brand.PopupDividerBrush" Color="#12FFFFFF" />
  <!-- Key caps: a raised surface-2 cap with a strong hairline and a darker bottom edge. -->
  <SolidColorBrush x:Key="Brand.KeyCapBrush" Color="#1E1E25" />
  <SolidColorBrush x:Key="Brand.KeyCapBorderBrush" Color="#33333D" />
  <SolidColorBrush x:Key="Brand.KeyCapEdgeBrush" Color="#08080A" />
  <SolidColorBrush x:Key="Brand.KeyCapTextBrush" Color="#E4E4EA" />
  <Color x:Key="Brand.ShadowColor">#FF000000</Color>
  <sys:Double x:Key="Brand.ShadowOpacity">0.55</sys:Double>

  <!-- The mark: the opal gradient, for the moment a value lands, the working sweep, and the time-left line. -->
  <LinearGradientBrush x:Key="Brand.MarkBrush" StartPoint="0,0.4" EndPoint="1,0.6">
    <GradientStop Offset="0" Color="#67E8F9" />
    <GradientStop Offset="0.35" Color="#818CF8" />
    <GradientStop Offset="0.65" Color="#C084FC" />
    <GradientStop Offset="1" Color="#F9A8D4" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Brand.OnMarkBrush" Color="#0B0B0E" />

  <SolidColorBrush x:Key="Brand.FlyoutFooterBrush" Color="#121216" />

  <SolidColorBrush x:Key="Brand.SuccessBrush" Color="#4ADE80" />
  <SolidColorBrush x:Key="Brand.WarningBrush" Color="#FBBF24" />
  <SolidColorBrush x:Key="Brand.DangerBrush" Color="#F87171" />
  <SolidColorBrush x:Key="Brand.SuccessSoftBrush" Color="#1F4ADE80" />

  <SolidColorBrush x:Key="Brand.LogoGlyphBrush" Color="#FFFFFF" />
  <DrawingImage x:Key="Brand.LogoMonoImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z" />
        <GeometryDrawing Brush="{StaticResource Brand.LogoGlyphBrush}" Geometry="{x:Static brand:BrandArt.Glyph}" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- ===== WPF-UI theme brushes, in Whisp's neutrals ===== -->
  <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#0B0B0E" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#0B0B0E" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#0B0B0E" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#121216" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#18181E" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#202028" />
  <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#121216" />
  <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#121216" />
  <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="#121216" />
  <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorSecondaryBrush" Color="#18181E" />
  <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorTertiaryBrush" Color="#202028" />
  <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorTransparentBrush" Color="#00FFFFFF" />

  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#121216" />
  <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#18181E" />
  <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#12FFFFFF" />
  <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#1C1C22" />

  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#18181E" />
  <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#202028" />
  <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#141419" />
  <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#141419" />
  <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#0AFFFFFF" />
  <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="#00FFFFFF" />
  <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="#2A2A33" />
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#29FFFFFF" />
  <SolidColorBrush x:Key="ControlStrokeColorTertiaryBrush" Color="#12FFFFFF" />
  <!-- Flat edges: Whisp's controls have one hairline, not Fluent's lighter top and darker bottom. -->
  <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#5CFFFFFF" />
  <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="#29FFFFFF" />
  <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#B3B3BD" />
  <SolidColorBrush x:Key="ControlStrongFillColorDisabledBrush" Color="#4DFFFFFF" />
  <SolidColorBrush x:Key="ControlAltFillColorTransparentBrush" Color="#00FFFFFF" />
  <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="ControlAltFillColorQuarternaryBrush" Color="#29FFFFFF" />
  <SolidColorBrush x:Key="ControlAltFillColorDisabledBrush" Color="#00FFFFFF" />

  <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00FFFFFF" />
  <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF" />
  <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="#00FFFFFF" />
  <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#12FFFFFF" />
  <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#9E040406" />
  <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#8B9BFF" />
  <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#0B0B0E" />
  <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#528B9BFF" />

  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F4F4F6" />
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B3B3BD" />
  <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#82828D" />
  <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5C5C66" />
  <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#0B0B0E" />

  <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#4ADE80" />
  <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FBBF24" />
  <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#F87171" />
  <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#8B9BFF" />
  <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="#B3B3BD" />
  <SolidColorBrush x:Key="SystemFillColorSolidNeutralBrush" Color="#82828D" />
  <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#1F4ADE80" />
  <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#1FFBBF24" />
  <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#1FF87171" />
  <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#298B9BFF" />
  <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="SystemFillColorSolidAttentionBackgroundBrush" Color="#18181E" />
  <SolidColorBrush x:Key="SystemFillColorSolidNeutralBackgroundBrush" Color="#18181E" />

  <!-- The sidebar: quiet items on the background, the active one on surface-2 with the opal marker. -->
  <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#0B0B0E" />
  <!-- No frame around the page: one hairline divides it from the sidebar (SettingsWindow). -->
  <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#00FFFFFF" />
  <SolidColorBrush x:Key="NavigationViewItemBackground" Color="#00FFFFFF" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0DFFFFFF" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#08FFFFFF" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#18181E" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedLeftFluent" Color="#18181E" />
  <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#C9C9D1" />
  <SolidColorBrush x:Key="NavigationViewItemForegroundLeftFluent" Color="#C9C9D1" />
  <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#F4F4F6" />
  <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOverLeftFluent" Color="#F4F4F6" />
  <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#B3B3BD" />
  <LinearGradientBrush x:Key="NavigationViewSelectionIndicatorForeground" StartPoint="0,1" EndPoint="0,0">
    <GradientStop Offset="0" Color="#67E8F9" />
    <GradientStop Offset="0.35" Color="#818CF8" />
    <GradientStop Offset="0.65" Color="#C084FC" />
    <GradientStop Offset="1" Color="#F9A8D4" />
  </LinearGradientBrush>
</ResourceDictionary>
