<!-- Brand brushes for the light theme, Whisp's palette. Same keys as Brand.Dark.xaml and Brand.HighContrast.xaml;
     reference them with DynamicResource. The second half replaces WPF-UI's own theme brushes, so its controls (cards,
     buttons, text boxes, the sidebar) wear the same neutrals. The accent colors come from the theme service. -->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime"
  xmlns:brand="clr-namespace:SmartPaste.App.UI.Brand">

  <!-- Neutrals: background, three surfaces, hairline borders, three text levels (AA-safe tertiary). -->
  <SolidColorBrush x:Key="Brand.BackgroundBrush" Color="#F7F7F9" />
  <SolidColorBrush x:Key="Brand.Surface1Brush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brand.Surface2Brush" Color="#F1F1F5" />
  <SolidColorBrush x:Key="Brand.Surface3Brush" Color="#E9E9EF" />
  <SolidColorBrush x:Key="Brand.BorderBrush" Color="#140C0C14" />
  <SolidColorBrush x:Key="Brand.BorderStrongBrush" Color="#240C0C14" />
  <SolidColorBrush x:Key="Brand.Text1Brush" Color="#0E0E12" />
  <SolidColorBrush x:Key="Brand.Text2Brush" Color="#4A4A55" />
  <SolidColorBrush x:Key="Brand.Text3Brush" Color="#6B6B77" />
  <SolidColorBrush x:Key="Brand.AccentBrush" Color="#5B63E6" />
  <SolidColorBrush x:Key="Brand.AccentSoftBrush" Color="#1A5B63E6" />
  <SolidColorBrush x:Key="Brand.TrackBrush" Color="#140C0C14" />
  <!-- The primary button: inverse colors, with the opal glow behind it. -->
  <SolidColorBrush x:Key="Brand.InverseBrush" Color="#0E0E12" />
  <SolidColorBrush x:Key="Brand.OnInverseBrush" Color="#FFFFFF" />
  <sys:Double x:Key="Brand.GlowOpacity">0.3</sys:Double>
  <sys:Double x:Key="Brand.GlowHoverOpacity">0.42</sys:Double>

  <!-- The chosen value, behind its text: a periwinkle selection, never the gradient (text never sits on it). -->
  <SolidColorBrush x:Key="Brand.HighlightFillBrush" Color="#335B63E6" />
  <SolidColorBrush x:Key="Brand.HighlightTextBrush" Color="#0E0E12" />
  <!-- Soft accent wash for selected rows and the card that holds the armed block. -->
  <SolidColorBrush x:Key="Brand.HighlightWashBrush" Color="#1A5B63E6" />

  <!-- Floating surfaces (picker, chips): white, with a hairline and a soft shadow. -->
  <SolidColorBrush x:Key="Brand.PopupSurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brand.PopupBorderBrush" Color="#1F0C0C14" />
  <SolidColorBrush x:Key="Brand.PopupTextBrush" Color="#0E0E12" />
  <SolidColorBrush x:Key="Brand.PopupSubtleTextBrush" Color="#4A4A55" />
  <SolidColorBrush x:Key="Brand.PopupHoverBrush" Color="#0A0C0C14" />
  <SolidColorBrush x:Key="Brand.PopupSelectedBrush" Color="#1A5B63E6" />
  <SolidColorBrush x:Key="Brand.PopupSelectedTextBrush" Color="#0E0E12" />
  <SolidColorBrush x:Key="Brand.PopupDividerBrush" Color="#140C0C14" />
  <!-- Key caps: a raised surface-2 cap with a strong hairline and a darker bottom edge. -->
  <SolidColorBrush x:Key="Brand.KeyCapBrush" Color="#F1F1F5" />
  <SolidColorBrush x:Key="Brand.KeyCapBorderBrush" Color="#DADAE1" />
  <SolidColorBrush x:Key="Brand.KeyCapEdgeBrush" Color="#C4C4CD" />
  <SolidColorBrush x:Key="Brand.KeyCapTextBrush" Color="#0E0E12" />
  <Color x:Key="Brand.ShadowColor">#FF101018</Color>
  <!-- Strength of the soft drop shadow under popups (DropShadowEffect ignores a color's alpha). -->
  <sys:Double x:Key="Brand.ShadowOpacity">0.16</sys:Double>

  <!-- The mark: the opal gradient, for the moment a value lands, the working sweep, and the time-left line. -->
  <LinearGradientBrush x:Key="Brand.MarkBrush" StartPoint="0,0.4" EndPoint="1,0.6">
    <GradientStop Offset="0" Color="#67E8F9" />
    <GradientStop Offset="0.35" Color="#818CF8" />
    <GradientStop Offset="0.65" Color="#C084FC" />
    <GradientStop Offset="1" Color="#F9A8D4" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Brand.OnMarkBrush" Color="#0B0B0E" />

  <!-- The footer strip of the tray flyout. -->
  <SolidColorBrush x:Key="Brand.FlyoutFooterBrush" Color="#F1F1F5" />

  <!-- Status colors as text need a step darker on white to pass AA. -->
  <SolidColorBrush x:Key="Brand.SuccessBrush" Color="#15803D" />
  <SolidColorBrush x:Key="Brand.WarningBrush" Color="#B45309" />
  <SolidColorBrush x:Key="Brand.DangerBrush" Color="#C42121" />
  <SolidColorBrush x:Key="Brand.SuccessSoftBrush" Color="#1A16A34A" />

  <!-- The monochrome mark in the theme's primary text color. -->
  <SolidColorBrush x:Key="Brand.LogoGlyphBrush" Color="#0E0E12" />
  <DrawingImage x:Key="Brand.LogoMonoImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z" />
        <GeometryDrawing Brush="{StaticResource Brand.LogoGlyphBrush}" Geometry="{x:Static brand:BrandArt.Glyph}" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- ===== WPF-UI theme brushes, in Whisp's neutrals ===== -->
  <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F7F7F9" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F7F7F9" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#F7F7F9" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#F1F1F5" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#E9E9EF" />
  <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorSecondaryBrush" Color="#F1F1F5" />
  <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorTertiaryBrush" Color="#E9E9EF" />
  <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorTransparentBrush" Color="#000C0C14" />

  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F7F7F9" />
  <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#140C0C14" />
  <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#EBEBEF" />

  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F1F1F5" />
  <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#E9E9EF" />
  <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#0A0C0C14" />
  <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="#000C0C14" />
  <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#240C0C14" />
  <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#2E0C0C14" />
  <SolidColorBrush x:Key="ControlStrokeColorTertiaryBrush" Color="#140C0C14" />
  <!-- Flat edges: Whisp's controls have one hairline, not Fluent's lighter top and darker bottom. -->
  <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#240C0C14" />
  <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#240C0C14" />
  <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#8C0C0C14" />
  <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="#370C0C14" />
  <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#4A4A55" />
  <SolidColorBrush x:Key="ControlStrongFillColorDisabledBrush" Color="#510C0C14" />
  <SolidColorBrush x:Key="ControlAltFillColorTransparentBrush" Color="#000C0C14" />
  <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#0A0C0C14" />
  <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="#140C0C14" />
  <SolidColorBrush x:Key="ControlAltFillColorQuarternaryBrush" Color="#1F0C0C14" />
  <SolidColorBrush x:Key="ControlAltFillColorDisabledBrush" Color="#000C0C14" />

  <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#000C0C14" />
  <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0D0C0C14" />
  <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#080C0C14" />
  <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="#000C0C14" />
  <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#140C0C14" />
  <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#240C0C14" />
  <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#240C0C14" />
  <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#470E0E12" />
  <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#5B63E6" />
  <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#335B63E6" />

  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#0E0E12" />
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#4A4A55" />
  <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#6B6B77" />
  <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#A3A3AD" />
  <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#FFFFFF" />

  <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#16A34A" />
  <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#D97706" />
  <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#DC2626" />
  <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#5B63E6" />
  <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="#4A4A55" />
  <SolidColorBrush x:Key="SystemFillColorSolidNeutralBrush" Color="#6B6B77" />
  <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#1A16A34A" />
  <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#1AD97706" />
  <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#14DC2626" />
  <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#1A5B63E6" />
  <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush" Color="#0A0C0C14" />
  <SolidColorBrush x:Key="SystemFillColorSolidAttentionBackgroundBrush" Color="#F1F1F5" />
  <SolidColorBrush x:Key="SystemFillColorSolidNeutralBackgroundBrush" Color="#F1F1F5" />

  <!-- The sidebar: quiet items on the background, the active one a raised white chip with the opal marker. -->
  <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#F7F7F9" />
  <!-- No frame around the page: one hairline divides it from the sidebar (SettingsWindow). -->
  <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#000C0C14" />
  <SolidColorBrush x:Key="NavigationViewItemBackground" Color="#000C0C14" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0A0C0C14" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#060C0C14" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FFFFFF" />
  <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedLeftFluent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#2E2E36" />
  <SolidColorBrush x:Key="NavigationViewItemForegroundLeftFluent" Color="#2E2E36" />
  <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#0E0E12" />
  <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOverLeftFluent" Color="#0E0E12" />
  <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#4A4A55" />
  <LinearGradientBrush x:Key="NavigationViewSelectionIndicatorForeground" StartPoint="0,1" EndPoint="0,0">
    <GradientStop Offset="0" Color="#67E8F9" />
    <GradientStop Offset="0.35" Color="#818CF8" />
    <GradientStop Offset="0.65" Color="#C084FC" />
    <GradientStop Offset="1" Color="#F9A8D4" />
  </LinearGradientBrush>
</ResourceDictionary>
