<ui:FluentWindow
  x:Class="SmartPaste.App.UI.Tray.FlyoutWindow"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:SmartPaste.App.UI.Controls"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Smart Paste"
  Width="360"
  MinWidth="0"
  MinHeight="0"
  ExtendsContentIntoTitleBar="True"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  Topmost="True"
  UseLayoutRounding="True"
  WindowBackdropType="Acrylic"
  WindowCornerPreference="Round"
  WindowStartupLocation="Manual">

  <ui:FluentWindow.Resources>
    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource Brand.SizeBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource Brand.SizeCaption}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style
      x:Key="Note"
      BasedOn="{StaticResource Caption}"
      TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="None" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A card on the acrylic: Windows 11's layered card with a hairline edge. -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Margin" Value="12,0,12,12" />
      <Setter Property="CornerRadius" Value="{StaticResource Brand.RadiusControl}" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- A quiet button: no chrome until hovered. Used in the footer and on cards. -->
    <Style x:Key="Subtle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Chrome"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              CornerRadius="4">
              <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                <Setter Property="Opacity" Value="0.8" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style
      x:Key="IconButton"
      BasedOn="{StaticResource Subtle}"
      TargetType="Button">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- The dot on the service chip: green when Jev is ready, amber or red when a key needs attention. -->
    <Style x:Key="ToneDot" TargetType="Ellipse">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="{DynamicResource SystemFillColorSolidNeutralBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Services.Tone}" Value="Good">
          <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Services.Tone}" Value="Caution">
          <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Services.Tone}" Value="Critical">
          <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A shortcut legend row: what it does on the left, its keys on the right. -->
    <DataTemplate x:Key="KeyCaps">
      <controls:KeyCap Margin="3,0,0,0" Text="{Binding}" />
    </DataTemplate>
    <ItemsPanelTemplate x:Key="KeyCapRow">
      <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>
  </ui:FluentWindow.Resources>

  <Grid x:Name="Root">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="EnterOffset" />
    </Grid.RenderTransform>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <!-- Sized to its content; only on a short screen, where the window hits its maximum height, does it scroll. -->
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: the mark, the name, the state in a few words, and the master switch. -->
    <Grid Margin="16,16,12,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <controls:LogoMark
        Width="32"
        Height="32"
        VerticalAlignment="Center" />
      <StackPanel
        Grid.Column="1"
        Margin="12,0,8,0"
        VerticalAlignment="Center">
        <TextBlock
          FontSize="15"
          Style="{StaticResource Title}"
          Text="Smart Paste" />
        <TextBlock
          Margin="0,1,0,0"
          Style="{StaticResource Caption}"
          Text="{Binding StatusLine}" />
      </StackPanel>
      <ui:ToggleSwitch
        Grid.Column="2"
        VerticalAlignment="Center"
        AutomationProperties.Name="Smart Paste on"
        IsChecked="{Binding IsOn}"
        ToolTip="Turn Smart Paste on or off" />
    </Grid>

    <StackPanel Grid.Row="1">
      <!-- A key needs fixing: what broke, what happens meanwhile, and one tap to the right settings page. -->
      <Border Visibility="{Binding Services.IsProblem, Converter={StaticResource SmartPaste.VisibleWhen}}">
        <Border.Style>
          <Style BasedOn="{StaticResource Card}" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Services.Tone}" Value="Critical">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Button
          Padding="12,10"
          HorizontalContentAlignment="Stretch"
          AutomationProperties.Name="{Binding Services.Text}"
          Command="{Binding OpenServiceSettingsCommand}"
          Style="{StaticResource Subtle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon
              Margin="0,1,0,0"
              VerticalAlignment="Top"
              FontSize="20">
              <ui:SymbolIcon.Style>
                <Style TargetType="ui:SymbolIcon">
                  <Setter Property="Symbol" Value="Warning20" />
                  <Setter Property="Filled" Value="True" />
                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Services.Tone}" Value="Critical">
                      <Setter Property="Symbol" Value="ErrorCircle20" />
                      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
            <StackPanel Grid.Column="1" Margin="10,0,8,0">
              <TextBlock Style="{StaticResource Title}" Text="{Binding Services.Text}" />
              <TextBlock
                Margin="0,2,0,0"
                Style="{StaticResource Note}"
                Text="{Binding Services.Detail}" />
            </StackPanel>
            <ui:SymbolIcon
              Grid.Column="2"
              VerticalAlignment="Center"
              FontSize="16"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Symbol="ChevronRight16" />
          </Grid>
        </Button>
      </Border>

      <!-- A new version is ready: one tap opens About, where the update installs. -->
      <Border Style="{StaticResource Card}" Visibility="{Binding UpdateVersion, Converter={StaticResource SmartPaste.VisibleWhen}}">
        <Button
          Padding="12,10"
          HorizontalContentAlignment="Stretch"
          AutomationProperties.Name="Install the new version"
          Command="{Binding OpenUpdateCommand}"
          Style="{StaticResource Subtle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon
              FontSize="20"
              Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
              Symbol="ArrowCircleUp20" />
            <TextBlock
              Grid.Column="1"
              Margin="10,0,8,0"
              VerticalAlignment="Center"
              Style="{StaticResource Body}">
              <Run Text="Version" />
              <Run FontWeight="SemiBold" Text="{Binding UpdateVersion, Mode=OneWay}" />
              <Run Text="is ready to install" />
            </TextBlock>
            <ui:SymbolIcon
              Grid.Column="2"
              FontSize="16"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Symbol="ChevronRight16" />
          </Grid>
        </Button>
      </Border>
    </StackPanel>

    <ScrollViewer
      Grid.Row="2"
      Focusable="False"
      VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Grid>
          <!-- Armed: what Ctrl+V can paste right now. -->
          <Border Style="{StaticResource Card}" Visibility="{Binding IsArmed, Converter={StaticResource SmartPaste.VisibleWhen}}">
            <StackPanel>
              <Grid Margin="14,12,6,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon
                  Margin="0,3,10,0"
                  VerticalAlignment="Top"
                  FontSize="20"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Symbol="{Binding Armed.OriginSymbol}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <controls:HighlighterMark Margin="-4,0,0,0" Fill="{DynamicResource Brand.HighlightFillBrush}">
                      <TextBlock
                        FontSize="{StaticResource Brand.SizeBody}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brand.HighlightTextBrush}"
                        Text="{Binding Armed.CountText}" />
                    </controls:HighlighterMark>
                    <TextBlock
                      Margin="4,0,0,0"
                      VerticalAlignment="Center"
                      Style="{StaticResource Title}"
                      Text="{Binding Armed.OriginText}" />
                  </StackPanel>
                  <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}">
                    <Run Text="{Binding Armed.ReaderText, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding Armed.ClearsInText, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" Command="{Binding ToggleRevealCommand}">
                  <Button.Style>
                    <Style BasedOn="{StaticResource IconButton}" TargetType="Button">
                      <Setter Property="ToolTip" Value="Show values" />
                      <Setter Property="AutomationProperties.Name" Value="Show values" />
                      <Setter Property="Content">
                        <Setter.Value>
                          <ui:SymbolIcon FontSize="18" Symbol="Eye20" />
                        </Setter.Value>
                      </Setter>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding RevealValues}" Value="True">
                          <Setter Property="ToolTip" Value="Hide values" />
                          <Setter Property="AutomationProperties.Name" Value="Hide values" />
                          <Setter Property="Content">
                            <Setter.Value>
                              <ui:SymbolIcon FontSize="18" Symbol="EyeOff20" />
                            </Setter.Value>
                          </Setter>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button
                  Grid.Column="3"
                  AutomationProperties.Name="Clear copied block"
                  Command="{Binding ClearCommand}"
                  Style="{StaticResource IconButton}"
                  ToolTip="Clear copied block">
                  <ui:SymbolIcon FontSize="18" Symbol="Broom20" />
                </Button>
              </Grid>

              <!-- Time left: the divider is a highlighter line that drains until the block clears. -->
              <Grid Height="2" Margin="14,0">
                <Border Background="{DynamicResource DividerStrokeColorDefaultBrush}" CornerRadius="1" />
                <Border
                  Background="{DynamicResource Brand.MarkBrush}"
                  CornerRadius="1"
                  RenderTransformOrigin="0,0.5">
                  <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding Armed.TimeLeft}" />
                  </Border.RenderTransform>
                </Border>
              </Grid>

              <ScrollViewer
                MaxHeight="300"
                Margin="0,6,0,8"
                Focusable="False"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl Focusable="False" ItemsSource="{Binding Armed.Groups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock
                          Margin="14,8,14,2"
                          FontWeight="SemiBold"
                          Style="{StaticResource Caption}"
                          Text="{Binding Title}"
                          Visibility="{Binding HasTitle, Converter={StaticResource SmartPaste.VisibleWhen}}" />
                        <ItemsControl Focusable="False" ItemsSource="{Binding Rows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid Margin="14,3" AutomationProperties.Name="{Binding SpokenText}">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="116" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                  Margin="0,0,8,0"
                                  FontSize="13"
                                  Style="{StaticResource Caption}"
                                  Text="{Binding Name}" />
                                <TextBlock
                                  Grid.Column="1"
                                  Style="{StaticResource Body}"
                                  Text="{Binding DisplayValue}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>

          <!-- Waiting for a copy: what to copy, and the two shortcuts that matter. -->
          <Border
            Padding="16,14,16,14"
            Style="{StaticResource Card}"
            Visibility="{Binding IsWaiting, Converter={StaticResource SmartPaste.VisibleWhen}}">
            <StackPanel>
              <TextBlock Style="{StaticResource Title}" Text="Copy a block of details" />
              <TextBlock
                Margin="0,2,0,0"
                Style="{StaticResource Note}"
                Text="A resume, an address, or a contact card." />
              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                  VerticalAlignment="Center"
                  Style="{StaticResource Body}"
                  Text="Paste into any form field" />
                <ItemsControl
                  Grid.Column="1"
                  Focusable="False"
                  ItemTemplate="{StaticResource KeyCaps}"
                  ItemsPanel="{StaticResource KeyCapRow}">
                  <ItemsControl.ItemsSource>
                    <x:Array Type="{x:Type sys:String}">
                      <sys:String>Ctrl</sys:String>
                      <sys:String>V</sys:String>
                    </x:Array>
                  </ItemsControl.ItemsSource>
                </ItemsControl>
                <TextBlock
                  Grid.Row="1"
                  Margin="0,8,0,0"
                  VerticalAlignment="Center"
                  Style="{StaticResource Body}"
                  Text="Pick a value yourself"
                  Visibility="{Binding PickerKeys, Converter={StaticResource SmartPaste.VisibleWhen}}" />
                <ItemsControl
                  Grid.Row="1"
                  Grid.Column="1"
                  Margin="0,8,0,0"
                  Focusable="False"
                  ItemTemplate="{StaticResource KeyCaps}"
                  ItemsPanel="{StaticResource KeyCapRow}"
                  ItemsSource="{Binding PickerKeys}" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Reading a copied block. -->
          <Border
            Padding="16,14"
            Style="{StaticResource Card}"
            Visibility="{Binding IsParsing, Converter={StaticResource SmartPaste.VisibleWhen}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <controls:ThinkingMark
                Width="26"
                Height="14"
                Margin="2,0,0,0"
                VerticalAlignment="Center"
                CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                Fill="{DynamicResource Brand.MarkBrush}" />
              <TextBlock
                Grid.Column="1"
                Margin="14,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource Body}"
                Text="Its fields appear here when it is done."
                TextTrimming="None"
                TextWrapping="Wrap" />
            </Grid>
          </Border>

          <!-- Paused for a while. -->
          <Border
            Padding="16,14"
            Style="{StaticResource Card}"
            Visibility="{Binding IsPaused, Converter={StaticResource SmartPaste.VisibleWhen}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource Body}"
                Text="Ctrl+V pastes normally until then."
                TextTrimming="None"
                TextWrapping="Wrap" />
              <ui:Button
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding ResumeCommand}"
                Content="Resume" />
            </Grid>
          </Border>

          <!-- Turned off. -->
          <Border
            Padding="16,14"
            Style="{StaticResource Card}"
            Visibility="{Binding IsOff, Converter={StaticResource SmartPaste.VisibleWhen}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource Body}"
                TextTrimming="None">
                <Run Text="Ctrl+V pastes normally." />
                <LineBreak />
                <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Nothing is watched." />
              </TextBlock>
              <ui:Button
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Appearance="Primary"
                Command="{Binding TurnOnCommand}"
                Content="Turn on" />
            </Grid>
          </Border>
        </Grid>

        <!-- Recent smart pastes: labels and kinds of value only. -->
        <StackPanel Margin="16,2,16,12">
          <TextBlock
            Margin="0,0,0,4"
            FontSize="13"
            Style="{StaticResource Title}"
            Text="Recent" />
          <ItemsControl
            Focusable="False"
            ItemsSource="{Binding Recent}"
            Visibility="{Binding HasRecent, Converter={StaticResource SmartPaste.VisibleWhen}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:SymbolIcon
                    Margin="0,1,12,0"
                    VerticalAlignment="Top"
                    FontSize="16"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Symbol="{Binding Symbol}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource Body}" Text="{Binding Label}" />
                    <TextBlock
                      Margin="0,1,0,0"
                      Style="{StaticResource Caption}"
                      Text="{Binding Detail}" />
                  </StackPanel>
                  <TextBlock
                    Grid.Column="2"
                    Margin="8,1,0,0"
                    VerticalAlignment="Top"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource Caption}"
                    Text="{Binding When}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock
            Style="{StaticResource Note}"
            Text="Your smart pastes show up here. Only field names are kept, never values."
            Visibility="{Binding HasRecent, Converter={StaticResource SmartPaste.VisibleWhen}, ConverterParameter=Not}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Footer: service health on the left; pause and settings on the right. -->
    <Border
      Grid.Row="3"
      Padding="8,6"
      Background="{DynamicResource Brand.FlyoutFooterBrush}"
      BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
      BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button
          HorizontalAlignment="Left"
          AutomationProperties.Name="{Binding Services.Text}"
          Command="{Binding OpenServiceSettingsCommand}"
          Style="{StaticResource Subtle}"
          ToolTip="Open Jev settings">
          <StackPanel Orientation="Horizontal">
            <Ellipse VerticalAlignment="Center" Style="{StaticResource ToneDot}" />
            <TextBlock
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Style="{StaticResource Caption}"
              Text="{Binding Services.Text}" />
          </StackPanel>
        </Button>
        <Button
          x:Name="PauseButton"
          Grid.Column="1"
          AutomationProperties.Name="Pause Smart Paste"
          Click="OnPauseClick"
          Style="{StaticResource Subtle}"
          Visibility="{Binding CanPause, Converter={StaticResource SmartPaste.VisibleWhen}}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon FontSize="16" Symbol="Pause20" />
            <TextBlock
              Margin="6,0,2,0"
              VerticalAlignment="Center"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Style="{StaticResource Caption}"
              Text="Pause" />
            <ui:SymbolIcon
              Margin="2,1,0,0"
              FontSize="12"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Symbol="ChevronDown12" />
          </StackPanel>
          <Button.ContextMenu>
            <ContextMenu ItemsSource="{Binding PauseOptions}" Placement="Top">
              <ContextMenu.ItemContainerStyle>
                <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                  <Setter Property="Header" Value="{Binding Label}" />
                  <Setter Property="Command" Value="{Binding Command}" />
                </Style>
              </ContextMenu.ItemContainerStyle>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button
          Grid.Column="2"
          Margin="2,0,0,0"
          AutomationProperties.Name="Settings"
          Command="{Binding OpenSettingsCommand}"
          Style="{StaticResource IconButton}"
          ToolTip="Settings">
          <ui:SymbolIcon FontSize="18" Symbol="Settings20" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
