<Application
  x:Class="SmartPaste.App.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="UI/Theme/Brand.xaml" />
        <!-- Swapped for Brand.Light.xaml or Brand.HighContrast.xaml by the theme service. -->
        <ResourceDictionary Source="UI/Theme/Brand.Dark.xaml" />
        <ResourceDictionary Source="UI/Theme/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
